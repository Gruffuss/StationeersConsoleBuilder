<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The SDK discovers debug assets before Directory.Build.targets disables Release symbols. -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- a runaway script's allocations stop at 512 MB (emcc MAXIMUM_MEMORY; the default is 2 GB) and the page's watchdog restarts the worker -->
    <EmccMaximumHeapSize>536870912</EmccMaximumHeapSize>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../Core/Core.csproj" /></ItemGroup>
</Project>
