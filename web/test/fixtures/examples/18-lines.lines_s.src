SCENE w=200 h=200 fit=stretch size=5 f=#8FA6B8
R x=0 y=0 w=200 h=200 f=#0B1622 fea=0
T x=4 y=3 w=192 h=6 text="cap: butt / round / square -- the dots mark the real ends"
