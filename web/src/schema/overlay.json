  { "ops": ["GR", "GC"], "key": "cy", "type": "num", "group": "gradient", "order": 9 },
  { "ops": ["GR"], "key": "r", "type": "num", "group": "gradient", "order": 10 },
  { "ops": ["GR"], "key": "fx", "type": "num", "group": "gradient", "order": 11, "defaultFrom": "cx" },
  { "ops": ["GR"], "key": "fy", "type": "num", "group": "gradient", "order": 12, "defaultFrom": "cy" },
  { "ops": ["GC"], "key": "a", "type": "num", "group": "gradient", "order": 13 },

  { "ops": ["DATA"], "key": "data", "type": "map", "group": "data", "order": 1 },
  { "ops": ["DATA"], "key": "nodes", "type": "map", "group": "data", "order": 2 },
  { "ops": ["DATA"], "key": "keep", "type": "flag", "group": "data", "order": 3 },
  { "ops": ["DATA"], "key": "snap", "type": "flag", "group": "data", "order": 4 },
