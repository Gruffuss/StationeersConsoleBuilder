{ "rows": [
  { "ops": ["SCENE"], "key": "w", "type": "num", "group": "scene", "order": 1, "range": [1, 1e9] },
  { "ops": ["SCENE"], "key": "h", "type": "num", "group": "scene", "order": 2, "range": [1, 1e9] },
  { "ops": ["SCENE"], "key": "fit", "type": "enum", "group": "scene", "order": 3, "enum": ["stretch", "contain", "cover"] },
  { "ops": ["SCENE"], "key": "ztext", "type": "flag", "group": "scene", "order": 4 },
  { "ops": ["SCENE"], "key": "nofill", "type": "flag", "group": "scene", "order": 5, "note": "a debug switch: skips fills, and every label too" },
  { "ops": ["SCENE"], "key": "nofeather", "type": "flag", "group": "scene", "order": 6 },
  { "ops": ["SCENE"], "key": "nopixeledges", "type": "flag", "group": "scene", "order": 8 },
  { "ops": ["SCENE"], "key": "noeval", "type": "flag", "group": "scene", "order": 7, "note": "a debug switch: only the boxes of R, SC and IMG stop evaluating, drawn 2x2 at 40,40" },

  { "ops": ["USE", "SC", "R", "LS", "T", "IMG", "YS"], "key": "x", "type": "num", "group": "geometry", "order": 1 },
  { "ops": ["USE", "SC", "R", "LS", "T", "IMG", "YS"], "key": "y", "type": "num", "group": "geometry", "order": 2 },
  { "ops": ["SC", "R", "T", "IMG"], "key": "w", "type": "num", "group": "geometry", "order": 3 },
  { "ops": ["SC", "R", "T", "IMG"], "key": "h", "type": "num", "group": "geometry", "order": 4 },
  { "ops": ["SC", "R", "IMG"], "key": "rx", "type": "num", "group": "geometry", "order": 5, "note": "or [tl, tr, br, bl]" },
  { "ops": ["C"], "key": "rx", "type": "num", "group": "geometry", "order": 5, "default": 0 },
  { "ops": ["C"], "key": "ry", "type": "num", "group": "geometry", "order": 6, "defaultFrom": "rx" },
  { "ops": ["SC", "R", "IMG"], "key": "ry", "type": "num", "group": "geometry", "order": 6, "defaultFrom": "rx", "note": "with a single rx, 0 squares the corners and any other value does nothing (the corners are drawn from rx); with a per-corner rx list (R, SC, IMG), ry does nothing" },
  { "ops": ["C"], "key": "cx", "type": "num", "group": "geometry", "order": 7 },
  { "ops": ["C"], "key": "cy", "type": "num", "group": "geometry", "order": 8 },
  { "ops": ["P"], "key": "d", "type": "path", "group": "geometry", "order": 9 },
  { "ops": ["L", "Y", "SP"], "key": "p", "type": "numlist", "group": "geometry", "order": 10 },
  { "ops": ["LS", "YS"], "key": "n", "type": "int", "group": "geometry", "order": 11 },
  { "ops": ["YS"], "key": "y2", "type": "num", "group": "geometry", "order": 12 },
  { "ops": ["SC"], "key": "ch", "type": "num", "group": "geometry", "order": 13 },
  { "ops": ["SC"], "key": "so", "type": "num", "group": "geometry", "order": 14, "requires": "sov", "defaultNote": "no forced offset: the player scrolls" },
  { "ops": ["SC"], "key": "sov", "type": "num", "group": "geometry", "order": 15, "requires": "so", "defaultNote": "no forced offset: the player scrolls", "note": "with its own so only: a so passed down to the SC is not its scroll offset (0.11.98; until then an SC with sov took one from a G or the SCENE header)" },
  { "ops": ["SP"], "key": "seg", "type": "int", "group": "geometry", "order": 16, "range": [1, 32] },
  { "ops": ["SP"], "key": "close", "type": "flag", "group": "geometry", "order": 17, "since": "0.11.74", "note": "a shadow needs it; an open SP fills as if closed (the code's reading, confirmed upstream at 0.11.94; REFERENCE.md is to follow)" },

  { "ops": ["G"], "key": "t", "type": "pair", "group": "transform", "order": 1 },
  { "ops": ["G"], "key": "r", "type": "num", "group": "transform", "order": 2 },
  { "ops": ["G"], "key": "s", "type": "pair", "group": "transform", "order": 3 },
  { "ops": ["G"], "key": "a", "type": "pair", "group": "transform", "order": 4 },
  { "ops": ["G"], "key": "m", "type": "numlist", "group": "transform", "order": 5, "defaultNote": "no matrix", "note": "six numbers [a, b, c, d, e, f]" },

  { "ops": ["R", "C", "Y", "P", "YS", "T", "SCENE", "G"], "key": "f", "type": "paint", "group": "fill", "order": 1 },
  { "ops": ["SP"], "key": "f", "type": "paint", "group": "fill", "order": 1, "note": "an open SP fills as if closed (the code's reading, confirmed upstream at 0.11.94; REFERENCE.md is to follow)" },
  { "ops": ["R", "C", "Y", "P", "YS", "T", "SP", "SCENE", "G"], "key": "fo", "type": "num", "group": "fill", "order": 2, "range": [0, 1], "requires": "f" },
  { "ops": ["P", "SCENE", "G"], "key": "fr", "type": "enum", "group": "fill", "order": 3, "enum": ["nonzero", "evenodd"] },
  { "ops": ["R", "C", "Y", "P", "YS", "T", "SP"], "key": "fat", "type": "num", "group": "fill", "order": 4, "requires": "f", "defaultNote": "the gradient is sampled by position", "note": "only when f is an @gradient" },
  { "ops": ["R", "C", "Y", "P", "L", "YS", "SP", "LS", "SCENE", "G"], "key": "fea", "type": "num", "group": "fill", "order": 5, "note": "the edge softness of the fill and the stroke (0.11.91)" },
  { "ops": ["YS", "SCENE", "G"], "key": "fea_edge", "type": "num", "group": "fill", "order": 6, "defaultFrom": "fea" },
  { "ops": ["YS"], "key": "fo2", "type": "num", "group": "fill", "order": 7, "range": [0, 1], "defaultNote": "no ramp: fo across the band" },
  { "ops": ["L", "LS"], "key": "f", "type": "paint", "group": "fill", "order": 1, "note": "an open line fills as if closed (the code's reading, confirmed upstream at 0.11.94; REFERENCE.md is to follow)" },
  { "ops": ["L", "LS"], "key": "fo", "type": "num", "group": "fill", "order": 2, "range": [0, 1], "requires": "f" },
  { "ops": ["L", "LS"], "key": "fat", "type": "num", "group": "fill", "order": 4, "requires": "f", "defaultNote": "the gradient is sampled by position", "note": "only when f is an @gradient" },

  { "ops": ["R", "C", "Y", "P", "L", "SP", "LS"], "key": "s", "type": "paint", "group": "stroke", "order": 1 },
  { "ops": ["G", "SCENE"], "key": "s_", "type": "paint", "group": "stroke", "order": 2, "kind": "S" },
  { "ops": ["R", "C", "Y", "P", "L", "SP", "LS", "SCENE", "G"], "key": "sw", "type": "num", "group": "stroke", "order": 3, "requires": "s" },
  { "ops": ["R", "C", "Y", "P", "L", "SP", "LS", "SCENE", "G"], "key": "so", "type": "num", "group": "stroke", "order": 4, "range": [0, 1], "requires": "s" },
  { "ops": ["R", "C", "Y", "P", "L", "SP", "LS", "SCENE", "G"], "key": "cap", "type": "enum", "group": "stroke", "order": 5, "enum": ["butt", "round", "square"], "requires": "s" },
  { "ops": ["R", "C", "Y", "P", "L", "SP", "LS", "SCENE", "G"], "key": "join", "type": "enum", "group": "stroke", "order": 6, "enum": ["miter", "round", "bevel"], "requires": "s" },
  { "ops": ["R", "C", "Y", "P", "L", "SP", "LS", "SCENE", "G"], "key": "ml", "type": "num", "group": "stroke", "order": 7, "requires": "s" },
  { "ops": ["R", "C", "Y", "P", "L", "SP", "LS", "SCENE", "G"], "key": "dash", "type": "numlist", "group": "stroke", "order": 8, "requires": "s" },
  { "ops": ["R", "C", "Y", "P", "L", "SP", "LS", "SCENE", "G"], "key": "dofs", "type": "num", "group": "stroke", "order": 9, "requires": "s" },
  { "ops": ["R", "C", "Y", "P", "L", "SP", "LS"], "key": "sat", "type": "num", "group": "stroke", "order": 10, "requires": "s", "defaultNote": "the gradient is sampled by position", "note": "only when s is an @gradient" },

  { "ops": ["T"], "key": "text", "type": "text", "group": "text", "order": 1 },
  { "ops": ["T"], "key": "fmt", "type": "text", "group": "text", "order": 2, "note": "the format of a number the label prints: a whole $ binding, or a placeholder without its own format. A printf conversion (%f, %e, %g, %d, %i or %x) or a .NET format ({0:F1}); empty fmt uses the default. Formats only a whole number takes ({0:D3}) retry as a long. The mod reports formats neither number route takes and conversion attempts that print no number; punctuation-only literals remain silent. Placeholder specs start at the first colon outside a data index and support composite braces and escapes" },
  { "ops": ["T"], "key": "unit", "type": "text", "group": "text", "order": 3, "note": "added to bound or templated text only, not to a plain literal" },
  { "ops": ["T"], "key": "missing", "type": "text", "group": "text", "order": 4 },
  { "ops": ["T", "SCENE", "G"], "key": "size", "type": "num", "group": "text", "order": 5 },
  { "ops": ["T", "SCENE", "G"], "key": "align", "type": "enum", "group": "text", "order": 6, "enum": ["left", "center", "right", "justified"], "alias": { "centre": "center", "justify": "justified" } },
  { "ops": ["T", "SCENE", "G"], "key": "valign", "type": "enum", "group": "text", "order": 7, "enum": ["top", "middle", "bottom"], "alias": { "center": "middle", "centre": "middle" } },
  { "ops": ["T", "SCENE", "G"], "key": "font", "type": "font", "group": "text", "order": 8, "note": "any name the Fonts mod knows" },
  { "ops": ["T", "SCENE", "G"], "key": "weight", "type": "string", "group": "text", "order": 9, "defaultNote": "regular", "note": "bold, or a number: 600 and up is bold (a number is read since 0.11.94)" },
  { "ops": ["T", "SCENE", "G"], "key": "cspace", "type": "num", "group": "text", "order": 10 },
  { "ops": ["T", "SCENE", "G"], "key": "kern", "type": "flag", "group": "text", "order": 11 },
  { "ops": ["T"], "key": "wrap", "type": "flag", "group": "text", "order": 12 },
  { "ops": ["T"], "key": "lh", "type": "num", "group": "text", "order": 13, "note": "shows only on a label of several lines" },
  { "ops": ["T"], "key": "ow", "type": "num", "group": "text", "order": 14, "defaultNote": "no outline" },
  { "ops": ["T"], "key": "oc", "type": "colour", "group": "text", "order": 15, "requires": "ow", "default": "#000000" },
  { "ops": ["T"], "key": "fl", "type": "string", "group": "text", "order": 16, "note": "first-line style: f, size, weight and font (weight=bold or 600 and up bolds the first line, normal or a lighter number takes bold off it since 0.11.98, another word is reported); not drawn by the preview" },
  { "ops": ["T"], "key": "fit", "type": "enum", "group": "text", "order": 17, "enum": ["none", "ellipsis", "shrink"] },
  { "ops": ["G"], "key": "fit", "type": "enum", "group": "text", "order": 17, "enum": ["stretch", "none", "ellipsis", "shrink", "fill", "contain", "cover", "scale-down"], "defaultNote": "each child keeps its own" },
  { "ops": ["T", "SCENE", "G"], "key": "min_size", "type": "num", "group": "text", "order": 18, "note": "used only with fit=shrink" },

  { "ops": ["IMG", "FONT"], "key": "src", "type": "string", "group": "image", "order": 1 },
  { "ops": ["IMG"], "key": "fit", "type": "enum", "group": "image", "order": 2, "enum": ["fill", "contain", "cover", "none", "scale-down"] },
  { "ops": ["IMG"], "key": "uv", "type": "numlist", "group": "image", "order": 3, "default": [0, 0, 1, 1], "note": "[u0, v0, u1, v1], 0..1, with u1 > u0 and v1 > v0" },
  { "ops": ["IMG"], "key": "at", "type": "pair", "group": "image", "order": 4 },
  { "ops": ["IMG"], "key": "off", "type": "pair", "group": "image", "order": 5 },
  { "ops": ["IMG"], "key": "tile", "type": "pair", "group": "image", "order": 6, "note": "or \"contain\" or \"cover\"", "defaultNote": "drawn once, not tiled" },
  { "ops": ["IMG"], "key": "rep", "type": "enum", "group": "image", "order": 7, "kind": "S", "enum": ["repeat", "once", "round", "space"], "alias": { "no-repeat": "once", "stretch": "repeat" }, "requires": "tile" },
  { "ops": ["IMG"], "key": "smp", "type": "enum", "group": "image", "order": 8, "enum": ["smooth", "point"] },
  { "ops": ["IMG"], "key": "slice", "type": "numlist", "group": "image", "order": 9, "defaultNote": "no nine-slice", "note": "four numbers [top, right, bottom, left], none negative" },
  { "ops": ["IMG"], "key": "bw", "type": "numlist", "group": "image", "order": 10, "requires": "slice", "defaultFrom": "slice", "note": "four numbers [top, right, bottom, left], none negative" },
  { "ops": ["IMG"], "key": "mid", "type": "flag", "group": "image", "order": 11, "requires": "slice" },
  { "ops": ["IMG"], "key": "srep", "type": "enum", "group": "image", "order": 12, "kind": "S", "enum": ["stretch", "repeat", "round", "space"], "alias": { "once": "repeat", "no-repeat": "repeat" }, "requires": "slice" },

  { "ops": ["RP"], "key": "n", "type": "int", "group": "repeat", "order": 1 },
  { "ops": ["RP"], "key": "lod", "type": "num", "group": "repeat", "order": 2, "kind": "N" },

  { "ops": ["G", "USE", "SC", "IMG"], "key": "o", "type": "num", "group": "effects", "order": 1, "range": [0, 1] },
  { "ops": ["G", "RP", "SC", "R", "C", "L", "Y", "P", "SP", "LS", "T", "IMG", "YS", "USE"], "key": "v", "type": "num", "group": "effects", "order": 2, "default": 1, "note": "0.5 or less hides the node and its children (0.11.75)" },
  { "ops": ["G", "USE"], "key": "clip", "type": "idref", "group": "effects", "order": 3, "note": "the bare id of a CP: unlike mask, which needs its @, clip takes no @ (clip=@c is reported as not declared)" },
  { "ops": ["G"], "key": "bri", "type": "num", "group": "effects", "order": 4, "kind": "E", "default": 1 },
  { "ops": ["G"], "key": "con", "type": "num", "group": "effects", "order": 5, "kind": "E", "default": 1 },
  { "ops": ["G"], "key": "sat", "type": "num", "group": "effects", "order": 6, "kind": "E", "default": 1, "range": [0, 1e9] },
  { "ops": ["G"], "key": "hue", "type": "num", "group": "effects", "order": 7, "kind": "E", "default": 0 },
  { "ops": ["G"], "key": "gray", "type": "num", "group": "effects", "order": 8, "kind": "E", "default": 0, "range": [0, 1] },
  { "ops": ["G"], "key": "sep", "type": "num", "group": "effects", "order": 9, "kind": "E", "default": 0, "range": [0, 1] },
  { "ops": ["G"], "key": "inv", "type": "num", "group": "effects", "order": 10, "kind": "E", "default": 0, "range": [0, 1] },
  { "ops": ["G"], "key": "mask", "type": "idref", "group": "effects", "order": 11, "note": "an @gradient: unlike clip, which takes the bare id, mask needs the @ (without it the mod reports it and draws unmasked); an empty mask is no mask" },
  { "ops": ["G"], "key": "blur", "type": "num", "group": "effects", "order": 12, "range": [0, 1e9], "defaultNote": "no blur" },
  { "ops": ["R", "C", "Y", "P", "T", "SP", "SCENE", "G"], "key": "sh", "type": "shadow", "group": "effects", "order": 13, "note": "each [dx, dy, blur, spread, #rrggbbaa] with a literal colour, \"inset\" as a sixth" },

  { "ops": ["R", "C"], "key": "click", "type": "flag", "group": "pointer", "order": 1, "requires": "id" },
  { "ops": ["R", "C"], "key": "press", "type": "flag", "group": "pointer", "order": 2, "requires": "id" },
  { "ops": ["R", "C"], "key": "xy", "type": "flag", "group": "pointer", "order": 3, "requires": "id" },
  { "ops": ["R", "C"], "key": "hoverev", "type": "flag", "group": "pointer", "order": 4, "requires": "id" },
  { "ops": ["R", "C"], "key": "drag", "type": "flag", "group": "pointer", "order": 5, "requires": "id" },
  { "ops": ["R", "C"], "key": "drop", "type": "flag", "group": "pointer", "order": 6, "requires": "id" },
  { "ops": ["T"], "key": "click", "type": "flag", "group": "pointer", "order": 1, "requires": "id", "since": "0.11.93", "note": "the label's box takes the click, over any shape below it, only while its text, as resolved, is not empty and SCENE nofill is off" },
  { "ops": ["T"], "key": "press", "type": "flag", "group": "pointer", "order": 2, "requires": "id", "since": "0.11.93", "note": "the label's box takes the click, over any shape below it, only while its text, as resolved, is not empty and SCENE nofill is off" },
  { "ops": ["T"], "key": "xy", "type": "flag", "group": "pointer", "order": 3, "requires": "id", "since": "0.11.93", "note": "the label's box takes the click, over any shape below it, only while its text, as resolved, is not empty and SCENE nofill is off" },
  { "ops": ["T"], "key": "hoverev", "type": "flag", "group": "pointer", "order": 4, "requires": "id", "since": "0.11.93", "note": "the label's box takes the click, over any shape below it, only while its text, as resolved, is not empty and SCENE nofill is off" },
  { "ops": ["T"], "key": "drag", "type": "flag", "group": "pointer", "order": 5, "requires": "id", "since": "0.11.93", "note": "the label's box takes the click, over any shape below it, only while its text, as resolved, is not empty and SCENE nofill is off" },
  { "ops": ["T"], "key": "drop", "type": "flag", "group": "pointer", "order": 6, "requires": "id", "since": "0.11.93", "note": "the label's box takes the click, over any shape below it, only while its text, as resolved, is not empty and SCENE nofill is off" },
  { "ops": ["IMG"], "key": "click", "type": "flag", "group": "pointer", "order": 1, "requires": "id", "since": "0.11.93", "note": "the picture's box takes the click, loaded or not (0.11.96), but only with a src (without one the mod reports it and records no hit); measured offline, not yet seen in game" },
  { "ops": ["IMG"], "key": "press", "type": "flag", "group": "pointer", "order": 2, "requires": "id", "since": "0.11.93", "note": "the picture's box takes the click, loaded or not (0.11.96), but only with a src (without one the mod reports it and records no hit); measured offline, not yet seen in game" },
  { "ops": ["IMG"], "key": "xy", "type": "flag", "group": "pointer", "order": 3, "requires": "id", "since": "0.11.93", "note": "the picture's box takes the click, loaded or not (0.11.96), but only with a src (without one the mod reports it and records no hit); measured offline, not yet seen in game" },
  { "ops": ["IMG"], "key": "hoverev", "type": "flag", "group": "pointer", "order": 4, "requires": "id", "since": "0.11.93", "note": "the picture's box takes the click, loaded or not (0.11.96), but only with a src (without one the mod reports it and records no hit); measured offline, not yet seen in game" },
  { "ops": ["IMG"], "key": "drag", "type": "flag", "group": "pointer", "order": 5, "requires": "id", "since": "0.11.93", "note": "the picture's box takes the click, loaded or not (0.11.96), but only with a src (without one the mod reports it and records no hit); measured offline, not yet seen in game" },
  { "ops": ["IMG"], "key": "drop", "type": "flag", "group": "pointer", "order": 6, "requires": "id", "since": "0.11.93", "note": "the picture's box takes the click, loaded or not (0.11.96), but only with a src (without one the mod reports it and records no hit); measured offline, not yet seen in game" },
  { "ops": ["L", "LS", "Y", "SP", "P"], "key": "click", "type": "flag", "group": "pointer", "order": 1, "since": "0.11.74", "note": "an open shape is hit along its stroke only (0.11.78)", "requires": "id" },
  { "ops": ["L", "LS", "Y", "SP", "P"], "key": "press", "type": "flag", "group": "pointer", "order": 2, "since": "0.11.74", "note": "an open shape is hit along its stroke only (0.11.78)", "requires": "id" },
  { "ops": ["L", "LS", "Y", "SP", "P"], "key": "xy", "type": "flag", "group": "pointer", "order": 3, "since": "0.11.74", "note": "an open shape is hit along its stroke only (0.11.78)", "requires": "id" },
  { "ops": ["L", "LS", "Y", "SP", "P"], "key": "hoverev", "type": "flag", "group": "pointer", "order": 4, "since": "0.11.74", "note": "an open shape is hit along its stroke only (0.11.78)", "requires": "id" },
  { "ops": ["L", "LS", "Y", "SP", "P"], "key": "drag", "type": "flag", "group": "pointer", "order": 5, "since": "0.11.74", "note": "an open shape is hit along its stroke only (0.11.78)", "requires": "id" },
  { "ops": ["L", "LS", "Y", "SP", "P"], "key": "drop", "type": "flag", "group": "pointer", "order": 6, "since": "0.11.74", "note": "an open shape is hit along its stroke only (0.11.78)", "requires": "id" },

  { "ops": ["GL"], "key": "x1", "type": "num", "group": "gradient", "order": 1 },
  { "ops": ["GL"], "key": "y1", "type": "num", "group": "gradient", "order": 2 },
  { "ops": ["GL"], "key": "x2", "type": "num", "group": "gradient", "order": 3 },
  { "ops": ["GL"], "key": "y2", "type": "num", "group": "gradient", "order": 4 },
